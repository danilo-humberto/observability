{
  "uid": "postgres-experiment",
  "title": "PostgreSQL — N+1 e JOIN",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "5s",
  "tags": [
    "etapa-6",
    "postgresql"
  ],
  "time": {
    "to": "now",
    "from": "now-15m"
