# Copie para .env e preencha a senha local antes de iniciar.
# Não versione o arquivo .env. Senhas com $ devem ficar entre aspas simples.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
PEDIDOS_PORT=3000

# Limites iniciais da Etapa 3, em milissegundos (exceto tamanho do pool).
PGPOOL_MAX=10
PGCONNECT_TIMEOUT_MS=1000
PGSTATEMENT_TIMEOUT_MS=1000
HTTP_TIMEOUT_MS=3000

# Somente na primeira inicialização de um volume vazio.
CLIENTS_COUNT=1000
ORDERS_COUNT=10000
