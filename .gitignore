# Dependências Node.js
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cobertura e resultados locais de testes
coverage/
.nyc_output/
test-results/

# Guias locais da apresentação (não versionar)
/docs/guia-local/
playwright-report/

# Build e caches
dist/
build/
.cache/
*.tsbuildinfo

# Variáveis de ambiente; manter exemplos sem segredos versionáveis
.env
.env.*
!.env.example
!.env.*.example

# Arquivos temporários
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# Dados persistentes locais; configurações continuam versionáveis
/.data/
/database/data/
/observability/jaeger/data/
/observability/prometheus/data/
/observability/grafana/data/

# Metadados do sistema operacional
.DS_Store
Thumbs.db
Desktop.ini
